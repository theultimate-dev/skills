diff --git a/test_snooze.py b/test_snooze.py
new file mode 100644
index 0000000..daa02c4
--- /dev/null
+++ b/test_snooze.py
@@ -0,0 +1,36 @@
+import contextlib
+import io
+import pathlib
+import tempfile
+import unittest
+
+import sprig
+
+
+class SnoozeTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.data = str(pathlib.Path(self.tmp.name) / "sprig.json")
+
+    def run_sprig(self, *args, today="2026-03-01"):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            code = sprig.main(["--data", self.data, "--today", today, *args])
+        return code, out.getvalue()
+
+    def test_snooze_hides_until_the_last_day(self):
+        self.run_sprig("add", "fern", "--every", "7")
+        self.run_sprig("snooze", "fern", "--days", "3", today="2026-03-08")
+        self.assertEqual(self.run_sprig("due", today="2026-03-10")[1], "")
+        self.assertEqual(self.run_sprig("due", today="2026-03-11")[1], "fern\n")
+
+    def test_water_clears_the_snooze(self):
+        self.run_sprig("add", "fern", "--every", "7")
+        self.run_sprig("snooze", "fern", "--days", "14", today="2026-03-08")
+        self.run_sprig("water", "fern", today="2026-03-09")
+        self.assertEqual(self.run_sprig("due", today="2026-03-16")[1], "fern\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
