+class OverviewTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.store = Store(Path(directory.name) / "records.json")
+        attachment = self.store.attachments / "1" / "notes.txt"
+        attachment.parent.mkdir(parents=True)
+        attachment.write_bytes(b"attached notes")
+        self.server = ThreadingHTTPServer(("127.0.0.1", 0), make_handler(self.store))
+        thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        thread.start()
+        self.addCleanup(thread.join, 5)
+        self.addCleanup(self.server.server_close)
+        self.addCleanup(self.server.shutdown)
+
+    def get(self, path, principal):
+        connection = HTTPConnection("127.0.0.1", self.server.server_port, timeout=5)
+        try:
+            connection.request("GET", path, headers={"X-Principal": principal})
+            response = connection.getresponse()
+            return response.status, response.read()
+        finally:
+            connection.close()
+
+    def test_list_shows_own_records_with_save_time(self):
+        self.store.update("alice", "1", "Listed note")
+        status, body = self.get("/records", "alice")
+        self.assertEqual(status, 200)
+        [summary] = json.loads(body)
+        self.assertEqual((summary["id"], summary["title"]), ("1", "Listed note"))
+        self.assertIsNotNone(summary["updated_at"])
+        self.assertEqual(json.loads(self.get("/records", "bob")[1]), [])
+
+    def test_owner_downloads_attachment(self):
+        self.assertEqual(self.get("/records/1/attachments/notes.txt", "alice"),
+                         (200, b"attached notes"))
+
+    def test_other_principal_cannot_download_attachment(self):
+        status, body = self.get("/records/1/attachments/notes.txt", "bob")
+        self.assertEqual(status, 403)
+        self.assertNotIn(b"attached notes", body)
+
+    def test_export_holds_only_own_records(self):
+        status, body = self.get("/records/export", "alice")
+        self.assertEqual(status, 200)
+        self.assertEqual(list(json.loads(body)), ["1"])
