+class HTTPBehaviorTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / 'records.json'
+        self.start_server()
+        self.addCleanup(self.stop_server)
+
+    def start_server(self):
+        self.server = ThreadingHTTPServer(('127.0.0.1', 0), make_handler(Store(self.path)))
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+
+    def stop_server(self):
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(timeout=3)
+
+    def request(self, method, principal, body=None):
+        connection = HTTPConnection('127.0.0.1', self.server.server_port, timeout=3)
+        try:
+            headers = {'Content-Type': 'application/json'}
+            if principal is not None:
+                headers['X-Principal'] = principal
+            connection.request(method, '/records/1',
+                               body=None if body is None else json.dumps(body), headers=headers)
+            response = connection.getresponse()
+            return response.status, json.loads(response.read())
+        finally:
+            connection.close()
+
+    def test_save_read_and_restart_use_real_disk(self):
+        self.assertEqual(self.request('PUT', 'alice', {'title': 'Persisted via HTTP'}),
+                         (200, {'owner': 'alice', 'title': 'Persisted via HTTP'}))
+        self.stop_server()
+        self.start_server()
+        self.assertEqual(self.request('GET', 'alice'),
+                         (200, {'owner': 'alice', 'title': 'Persisted via HTTP'}))
+
+    def test_denied_reads_and_updates_preserve_disk_and_owner_read(self):
+        self.assertEqual(self.request('PUT', 'alice', {'title': 'Owner value'})[0], 200)
+        before = self.path.read_bytes()
+        for principal in ('bob', None):
+            for method, body in (('GET', None), ('PUT', {'title': 'Forbidden'})):
+                with self.subTest(principal=principal, method=method):
+                    status, payload = self.request(method, principal, body)
+                    self.assertEqual(status, 403)
+                    self.assertEqual(payload, {'error': 'Record unavailable'})
+                    self.assertEqual(self.path.read_bytes(), before)
+                    self.assertEqual(self.request('GET', 'alice')[1]['title'], 'Owner value')
+
+    def test_invalid_input_returns_feedback_without_mutation(self):
+        before = self.path.read_bytes()
+        status, payload = self.request('PUT', 'alice', {'title': ' '})
+        self.assertEqual(status, 400)
+        self.assertEqual(payload, {'error': 'Title is required'})
+        self.assertEqual(self.path.read_bytes(), before)
+
+
+if __name__ == '__main__':
